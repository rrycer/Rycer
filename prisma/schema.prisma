// Prisma schema for Rycer — a personal, modular app platform.
//
// Convention for adding a new feature module: give its models a short
// comment banner (like "Workouts module" below) and, where it needs its
// own data, scope rows to `userId` so the schema stays ready for
// multi-user/auth even though today there's just one user.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  exercises Exercise[]
  workouts  Workout[]
}

// --- Workouts module (the "Strong" replacement) ---------------------------

enum WeightUnit {
  LB
  KG
}

model Exercise {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String? // e.g. "Chest", "Legs", "Back" — free text, user-defined
  createdAt DateTime @default(now())

  workoutExercises WorkoutExercise[]

  @@unique([userId, name])
  @@index([userId])
}

model Workout {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  name      String? // e.g. "Push Day" — optional
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises WorkoutExercise[]

  @@index([userId, date])
}

// One occurrence of an exercise within a workout (ordered), holding its sets.
model WorkoutExercise {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order      Int // position within the workout, 0-based
  notes      String?

  sets WorkoutSet[]

  @@index([workoutId])
  @@index([exerciseId])
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int // position within the exercise, 1-based
  weight            Float?
  unit              WeightUnit      @default(LB)
  reps              Int?
  isWarmup          Boolean         @default(false)
  completed         Boolean         @default(true)
  createdAt         DateTime        @default(now())

  @@index([workoutExerciseId])
}
